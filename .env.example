# Only needed to run the backend on your own computer.
# On Netlify, the database and Gemini key are provided automatically.

# Any PostgreSQL connection string (e.g. a free Neon database)
DATABASE_URL=postgresql://user:password@host/dbname

# Any long random text
JWT_SECRET=change-me

# Free key from https://aistudio.google.com/apikey (optional: without it, a rule-based fallback is used)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

PORT=5000
